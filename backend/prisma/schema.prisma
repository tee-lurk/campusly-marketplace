datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  user
  admin
}

enum ProductStatus {
  pending
  approved
  rejected
  sold
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  password_hash String
  role          Role            @default(user)
  is_banned     Boolean         @default(false)
  banned_reason String?
  banned_at     DateTime?
  created_at    DateTime        @default(now())
  profile       Profile?
  products      Product[]       @relation("SellerProducts")
  transactions  Transaction[]   @relation("BuyerTransactions")
  reviews       ProductReview[] @relation("AdminReviews")
}

model Profile {
  id           String   @id @default(uuid())
  user_id      String   @unique
  user         User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  username     String   @unique
  name         String
  bio          String?
  avatar_url   String?
  is_verified  Boolean  @default(false)
  phone                 String?
  student_id            String?
  student_id_card_url   String?
  verification_status   String   @default("unverified")
  verification_reason   String?
  notify_email          Boolean  @default(true)
  notify_push           Boolean  @default(true)
  notify_sms            Boolean  @default(false)
}

model Category {
  id           String        @id @default(uuid())
  name         String        @unique
  products     Product[]
  productTypes ProductType[]
}

model ProductType {
  id          String    @id @default(uuid())
  category_id String
  category    Category  @relation(fields: [category_id], references: [id], onDelete: Cascade)
  name        String
  products    Product[]

  @@unique([category_id, name])
}

model Product {
  id              String         @id @default(uuid())
  user_id         String
  seller          User           @relation("SellerProducts", fields: [user_id], references: [id], onDelete: Cascade)
  title           String
  description     String
  price           Float
  status          ProductStatus  @default(pending)
  category_id     String
  category        Category       @relation(fields: [category_id], references: [id])
  product_type_id String
  productType     ProductType    @relation(fields: [product_type_id], references: [id])
  is_featured     Boolean        @default(false)
  is_hidden       Boolean        @default(false)
  report_count    Int            @default(0)
  deliverable_file_url String?
  created_at      DateTime       @default(now())
  images          ProductImage[]
  reviews         ProductReview[]
  transactions    Transaction[]
}

model ProductImage {
  id         String   @id @default(uuid())
  product_id String
  product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  image_url  String
}

model ProductReview {
  id          String        @id @default(uuid())
  product_id  String
  product     Product       @relation(fields: [product_id], references: [id], onDelete: Cascade)
  admin_id    String
  admin       User          @relation("AdminReviews", fields: [admin_id], references: [id], onDelete: Cascade)
  status      ProductStatus
  reason      String?
  reviewed_at DateTime      @default(now())
}

model Transaction {
  id            String   @id @default(uuid())
  product_id    String
  product       Product  @relation(fields: [product_id], references: [id])
  buyer_id      String
  buyer         User     @relation("BuyerTransactions", fields: [buyer_id], references: [id])
  payment_id    String?  // Stripe payment intent ID
  status        String   @default("pending") // e.g. pending, completed, failed
  is_test       Boolean  @default(true)      // true for fake-checkout, false once Stripe is live
  buyer_comment String?
  buyer_rating  Int?
  created_at    DateTime @default(now())
}
